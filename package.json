{
  "name": "open-base",
  "private": true,
  "workspaces": [
    "cli",
    "mcp",
    "web",
    "web-next"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter web build && bun run --filter web-next build",
    "build:api-types": "bun run --filter web build:types",
    "typecheck": "bun run build:api-types && bun run --filter web-next check && bun run --filter cli check",
    "test:web": "bun run --filter web test",
    "check": "vp check"
  },
  "devDependencies": {
    "vite-plus": "^0.1.24"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "postcss": "8.5.15",
    "ws": "8.21.0"
  },
  "packageManager": "bun@1.3.14"
}
