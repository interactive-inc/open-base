# open-base API base URL (the web app serves it under /api)
# On Cloudflare, a service binding named API_SERVICE in web/wrangler.jsonc makes
# server-side calls reach the API Worker directly; without it this URL is used.
NEXT_PUBLIC_API_URL=https://base.localhost/api

# Optional: Sentry project DSN. Leave blank to disable error reporting.
NEXT_PUBLIC_SENTRY_DSN=
IDENTITY_LOGIN_URL=
IDENTITY_REDIRECT_URI=http://localhost:3000/auth/broker/callback
LOGOUT_REDIRECT_URL=
NEXT_PUBLIC_IDENTITY_LOGIN_URL=
NEXT_PUBLIC_PASSWORD_LOGIN_HIDDEN=
NEXT_PUBLIC_LOGIN_HIDDEN=

# Optional: public demo account prefilled on the login form. Both must be set.
# These values are shown to every visitor; use a read-only account.
NEXT_PUBLIC_DEMO_LOGIN_EMAIL=
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=

# Optional: deployment brand name shown in the tab title, sidebar logo, and
# the login screen (NEXT_PUBLIC_LOGIN_HIDDEN mode shows this name only).
NEXT_PUBLIC_APP_NAME=
