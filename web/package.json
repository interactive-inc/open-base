{
  "name": "web",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/api/app.d.ts",
      "default": "./src/api/app.ts"
    }
  },
  "scripts": {
    "build": "bun run build:types && vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "gen:app": "bun run scripts/gen-app.ts",
    "gen:app:check": "bun run scripts/gen-app.ts --check",
    "gen:composition": "bun run scripts/gen-composition-lists.ts",
    "gen:composition:check": "bun run scripts/gen-composition-lists.ts --check",
    "setup:dev-vars": "bash scripts/init-dev-vars.sh",
    "dev": "vite --port ${PORT:-18787} --strictPort",
    "db:migrate:local": "void db migrate",
    "db:migrate": "bun run db:check:remote && void deploy --platform cloudflare",
    "db:seed:local": "echo \"Use the CLI bootstrap command to initialize System and Company.\"",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "db:check:remote": "bun scripts/check-remote-migration-journal.ts",
    "ops:attachments:replicate": "bun run scripts/replicate-attachments.ts",
    "ops:attachments:erasure-ledger": "bun run scripts/attachment-erasure-ledger.ts",
    "lint:route-authorization": "bun run scripts/check-route-authorization.ts",
    "lint:company-source": "bun run scripts/check-company-context.ts",
    "lint:sql-bind-cast": "bun run scripts/check-sql-bind-cast.ts",
    "lint:system-source": "bun scripts/check-shared-system-source.ts",
    "test": "bun test src/contexts src/lib src/api",
    "test:unit": "bun test src/contexts src/lib src/api --path-ignore-patterns='**/*.d1.test.ts'",
    "test:d1": "bun ../scripts/test-d1.ts",
    "test:acceptance": "bun scripts/foundation-only-acceptance.ts",
    "check": "bun run gen:app:check && bun run gen:composition:check && bun run lint:route-authorization && bun run lint:system-source && bun run lint:company-source && bun run lint:boundaries && bun run build:types && tsc --noEmit && tsc --noEmit -p tsconfig.pages.json",
    "lint:boundaries": "bun scripts/check-context-boundaries.ts && bun scripts/check-system-context-boundary.ts && bun scripts/check-table-ownership-isolation.ts && bun scripts/check-api-composition-routes.ts",
    "postinstall": "void prepare"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "jose": "^6.2.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@simplewebauthn/server": "13.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@void/react": "1.2.1",
    "dts-bundle-generator": "9.5.1",
    "miniflare": "5.20260730.0-alpha",
    "oxc-transform-react": "0.149.0",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "void": "1.2.1",
    "wrangler": "^4.118.0"
  },
  "systemProductMarkers": [
    "open-base",
    "base.localhost"
  ]
}
