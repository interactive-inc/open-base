wrangler.jsonc

# env
.env
.env.production
# .env とその派生。公開リポジトリなので接頭辞で丸ごと除外する。
.env*
!.env.example
# 旧wranglerの秘密値ファイル
.dev.vars*

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# misc
.DS_Store

# 公開デモなどの追加の配備設定（ドメイン・バインディング ID を含むためコミットしない）
wrangler.*.jsonc

# Void（生成物と配備固有の設定。リソースIDとアカウントを含むためコミットしない）
.void/
.void-wrangler.jsonc
void.deploy.json
void.lock.json

# 旧wranglerの配備設定の退避先（本番の識別子を含む）
.deploy/
