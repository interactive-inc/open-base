{
  "name": "api",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/api/app.d.ts",
      "default": "./src/api/app.ts"
    }
  },
  "scripts": {
    "build": "bun run build:types && wrangler deploy src/index.ts --dry-run --minify --outdir dist/worker --name api --compatibility-date 2026-05-24 --compatibility-flags nodejs_compat",
    "build:types": "tsc -p tsconfig.build.json",
    "gen:app": "bun run scripts/gen-app.ts",
    "gen:app:check": "bun run scripts/gen-app.ts --check",
    "gen:composition": "bun run scripts/gen-composition-lists.ts",
    "gen:composition:check": "bun run scripts/gen-composition-lists.ts --check",
    "setup:dev-vars": "bash scripts/init-dev-vars.sh",
    "dev": "bash scripts/dev-restart.sh",
    "dev:no-restart": "wrangler dev",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply base --local",
    "db:migrate": "bun run db:check:remote && wrangler d1 migrations apply base --remote",
    "db:seed:local": "echo \"Use the CLI bootstrap command to initialize System and Company.\"",
    "db:check:remote": "bun scripts/check-remote-migration-journal.ts --config wrangler.jsonc",
    "ops:attachments:replicate": "bun run scripts/replicate-attachments.ts",
    "ops:attachments:erasure-ledger": "bun run scripts/attachment-erasure-ledger.ts",
    "lint:route-authorization": "bun run scripts/check-route-authorization.ts",
    "lint:company-source": "bun run scripts/check-company-context.ts",
    "lint:sql-bind-cast": "bun run scripts/check-sql-bind-cast.ts",
    "lint:system-source": "bun scripts/check-shared-system-source.ts",
    "test": "bun test src/contexts src/lib",
    "test:unit": "bun test src/contexts src/lib --path-ignore-patterns='**/*.d1.test.ts'",
    "test:d1": "bun ../scripts/test-d1.ts",
    "test:acceptance": "bun scripts/foundation-only-acceptance.ts",
    "check": "bun run gen:app:check && bun run gen:composition:check && bun run lint:route-authorization && bun run lint:system-source && bun run lint:company-source && bun run lint:boundaries && bun run build:types && tsc --noEmit",
    "lint:boundaries": "bun scripts/check-context-boundaries.ts && bun scripts/check-system-context-boundary.ts && bun scripts/check-table-ownership-isolation.ts && bun scripts/check-api-composition-routes.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "jose": "^5.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bun": "^1.3.14",
    "dts-bundle-generator": "9.5.1",
    "miniflare": "5.20260730.0-alpha",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0"
  },
  "systemProductMarkers": [
    "open-base",
    "base.localhost"
  ]
}
